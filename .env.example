BQM_COLLECTOR_URL=http://192.168.10.194:8000
COLLECTOR_SERIAL_DEVICE=/dev/serial/by-id/usb-FTDI_FT232R_USB_UART_A50285BI-if00-port0
BQS_INVERTER_TRANSPORT=solarman_v5
BQS_INVERTER_HOST=192.168.20.138
BQS_INVERTER_TCP_PORT=8899
BQS_INVERTER_LOGGER_SERIAL=3503566593
BQM_COLLECTOR_TIMEOUT_SECONDS=5
BQM_LIVE_POLL_INTERVAL_SECONDS=5
BQM_STALE_AFTER_SECONDS=30
BQM_OFFLINE_AFTER_SECONDS=120
BQM_BACKFILL_PAGE_SIZE=500
BQM_LOG_INTERVAL_SECONDS=60
BQM_RETENTION_DAYS=1095
# Admin console at /admin. Leave both blank to keep admin disabled.
# Set a real password in your own .env (which is gitignored), never here.
BQM_ADMIN_PASSWORD=
# Optional: fixes the session-signing key so logins survive a restart.
# If blank, a random secret is generated once and stored in the database.
BQM_ADMIN_SECRET=
BQM_RACK_NAME=Eco-worthy Rack
BQM_RACK_BUILDER=Tran Thanh Tuan
BQM_RACK_LOCATION=Battery room
BQM_COLLECTOR_NAME=Raspberry Pi collector
BQM_BATTERY_IDS=rack-1,rack-2,rack-3
BQM_BATTERY_ADDRESSES=1,2,3
BQM_BATTERY_NAMES=Rack Battery 1,Rack Battery 2,Rack Battery 3
BQM_BATTERY_IPS=,,
BQM_BATTERY_MODELS=Eco-worthy server rack battery,Eco-worthy server rack battery,Eco-worthy server rack battery
# PSE Schedule 327, Residential Time-of-Use with Super Off-Peak.
# Prices as PSE publishes them for this plan. Re-check them at each rate
# filing. The period structure (which hours are on-peak, which months are
# winter, which holidays are off-peak) lives in the code, not here.
#   On-peak        weekdays 7-10 a.m. and 5-8 p.m., excluding legal holidays
#   Off-peak       all other hours between 7 a.m. and 11 p.m.
#   Super off-peak every day 11 p.m. to 7 a.m., one price year round
# Winter is October 1 - March 31; summer is April 1 - September 30.
# Set municipal tax only when the exact city rate is known; King County alone
# does not determine it.
BQM_UTILITY_PROVIDER=Puget Sound Energy
BQM_UTILITY_SCHEDULE=Residential Time-of-Use with Super Off-Peak (Schedule 327)
BQM_UTILITY_REGION=King County, WA
BQM_UTILITY_RATE_EFFECTIVE_DATE=2026-01-29
# The tariff's own clock. Time-of-use hours are wall-clock hours in PSE's
# service territory, not the browser's timezone.
BQM_UTILITY_TIMEZONE=America/Los_Angeles
BQM_UTILITY_ON_PEAK_WINTER_USD_PER_KWH=0.504
BQM_UTILITY_ON_PEAK_SUMMER_USD_PER_KWH=0.272
BQM_UTILITY_OFF_PEAK_WINTER_USD_PER_KWH=0.127
BQM_UTILITY_OFF_PEAK_SUMMER_USD_PER_KWH=0.122
BQM_UTILITY_SUPER_OFF_PEAK_USD_PER_KWH=0.076
BQM_UTILITY_BASIC_CHARGE_USD=7.49
BQM_UTILITY_MUNICIPAL_TAX_PERCENT=0
# Current conditions shown in Live Home Energy. Defaults are Kent, Washington;
# replace latitude and longitude with the household's coordinates for accuracy.
BQM_WEATHER_ENABLED=true
BQM_WEATHER_LATITUDE=47.3809
BQM_WEATHER_LONGITUDE=-122.2348
BQM_WEATHER_LOCATION=Kent, WA
BQM_WEATHER_TIMEOUT_SECONDS=4
BQM_WEATHER_REFRESH_SECONDS=600
BQS_BUFFER_RETENTION_HOURS=24
BQS_BUFFER_SAMPLE_INTERVAL=60
