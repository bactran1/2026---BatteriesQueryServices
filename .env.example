BQM_COLLECTOR_URL=http://192.168.10.194:8000
COLLECTOR_SERIAL_DEVICE=/dev/serial/by-id/usb-FTDI_FT232R_USB_UART_A50285BI-if00-port0
BQS_INVERTER_TRANSPORT=solarman_v5
BQS_INVERTER_HOST=192.168.20.138
BQS_INVERTER_TCP_PORT=8899
BQS_INVERTER_LOGGER_SERIAL=3503566593
BQM_COLLECTOR_TIMEOUT_SECONDS=5
BQM_LIVE_POLL_INTERVAL_SECONDS=5
BQM_STALE_AFTER_SECONDS=30
BQM_OFFLINE_AFTER_SECONDS=120
BQM_BACKFILL_PAGE_SIZE=500
BQM_LOG_INTERVAL_SECONDS=60
BQM_RETENTION_DAYS=1095
# Admin console at /admin. Leave both blank to keep admin disabled.
# Set a real password in your own .env (which is gitignored), never here.
BQM_ADMIN_PASSWORD=
# Optional: fixes the session-signing key so logins survive a restart.
# If blank, a random secret is generated once and stored in the database.
BQM_ADMIN_SECRET=
BQM_RACK_NAME=Eco-worthy Rack
BQM_RACK_BUILDER=Tran Thanh Tuan
BQM_RACK_LOCATION=Battery room
BQM_COLLECTOR_NAME=Raspberry Pi collector
# The rack: three Eco-worthy 48 V 100 Ah rack packs on DIP addresses 1-3 and a
# first-generation Eco-worthy 51.2 V 314 Ah floor-standing unit on casters whose
# PACE BMS answers at address 2 on its own adapter. The collector's config.toml
# lists the same four packs. Form factors
# are "rack" (a module in the stack) or "floor" (a floor-standing unit drawn
# beside the rack).
BQM_BATTERY_IDS=rack-1,rack-2,rack-3,rack-4
BQM_BATTERY_ADDRESSES=1,2,3,2
BQM_BATTERY_NAMES=Rack Battery 1,Rack Battery 2,Rack Battery 3,Rack Battery 4
BQM_BATTERY_IPS=,,,
BQM_BATTERY_MODELS=Eco-worthy 48V 100Ah server rack battery,Eco-worthy 48V 100Ah server rack battery,Eco-worthy 48V 100Ah server rack battery,Eco-worthy 51.2V 314Ah floor-standing battery (first generation)
BQM_BATTERY_FORM_FACTORS=rack,rack,rack,floor
# PSE electricity prices, taken line by line from the household's October
# 2026 statement. Every price below is the statement's own per-kWh figure,
# before city tax. Re-check them against each new statement; the period
# structure (which hours are on-peak, which months are winter, which
# holidays are off-peak) lives in the code, not here.
#   Peak           weekdays 7-10 a.m. and 5-8 p.m., excluding legal holidays
#   Off-peak       weekdays 10 a.m.-5 p.m. and 8-11 p.m.; weekends and legal
#                  holidays 7 a.m.-11 p.m.
#   Super off-peak every day 11 p.m. to 7 a.m.
# Winter is October 1 - March 31; summer is April 1 - September 30.
BQM_UTILITY_PROVIDER=Puget Sound Energy
BQM_UTILITY_SCHEDULE=Residential Time-of-Use with Super Off-Peak (Schedule 327)
BQM_UTILITY_REGION=King County, WA
BQM_UTILITY_RATE_EFFECTIVE_DATE=2026-10-01
# The tariff's own clock. Time-of-use hours are wall-clock hours in PSE's
# service territory, not the browser's timezone.
BQM_UTILITY_TIMEZONE=America/Los_Angeles
# Schedule 327 energy charges. The winter lines are the prices effective
# October 1, 2026; the summer lines are the statement's September prices,
# which predate that change (PSE's October 1 summary puts each summer price
# about 0.001654 higher).
BQM_UTILITY_ON_PEAK_WINTER_USD_PER_KWH=0.511994
BQM_UTILITY_ON_PEAK_SUMMER_USD_PER_KWH=0.278604
BQM_UTILITY_OFF_PEAK_WINTER_USD_PER_KWH=0.135507
BQM_UTILITY_OFF_PEAK_SUMMER_USD_PER_KWH=0.128820
BQM_UTILITY_SUPER_OFF_PEAK_WINTER_USD_PER_KWH=0.083961
BQM_UTILITY_SUPER_OFF_PEAK_SUMMER_USD_PER_KWH=0.082307
# Per-kWh riders and credits billed on every kilowatt-hour on either
# schedule, netted: electric conservation program charge 0.009409 plus power
# cost adjustment 0.038719, less energy exchange credit 0.006648 and other
# credits 0.002378.
BQM_UTILITY_RIDERS_USD_PER_KWH=0.039102
# PSE Schedule 7, Residential Service: the standard plan the Energy Savings
# figure is compared with. Two tiers: the first 600 kWh per 30 days at the
# tier-1 price, prorated by day (the statement's 18-day period got 360 kWh),
# and the rest at the tier-2 price. These are the statement's September
# prices, before the October 1 change (the October 1 summary puts them at
# about 0.150017 and 0.169434).
BQM_UTILITY_COMPARISON_SCHEDULE=Residential Service (Schedule 7)
BQM_UTILITY_TIER_1_USD_PER_KWH=0.148363
BQM_UTILITY_TIER_2_USD_PER_KWH=0.167780
BQM_UTILITY_TIER_1_LIMIT_KWH=600
BQM_UTILITY_TIER_1_PERIOD_DAYS=30
BQM_UTILITY_BASIC_CHARGE_USD=7.49
# Kent's utility tax on electricity, applied to both plans. State utility
# tax is already inside the prices above, as it is on the statement.
BQM_UTILITY_MUNICIPAL_TAX_PERCENT=6.695
# Current conditions shown in Live Home Energy. Defaults are Kent, Washington;
# replace latitude and longitude with the household's coordinates for accuracy.
BQM_WEATHER_ENABLED=true
BQM_WEATHER_LATITUDE=47.3809
BQM_WEATHER_LONGITUDE=-122.2348
BQM_WEATHER_LOCATION=Kent, WA
BQM_WEATHER_TIMEOUT_SECONDS=4
BQM_WEATHER_REFRESH_SECONDS=600
BQS_BUFFER_RETENTION_HOURS=24
BQS_BUFFER_SAMPLE_INTERVAL=60
